# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call this API (your portal's real domain(s))
ALLOWED_ORIGINS=https://konnectfree.example.com,http://localhost:5500

# ---- Database ----
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/konnectfree

# ---- JWT (admin auth) ----
# Generate a strong random value: `openssl rand -hex 64`
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=2h

# ---- IntaSend ----
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_xxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_test_xxxxxxxx
# Test vs live is detected automatically from whether INTASEND_SECRET_KEY
# contains "_test_" or "_live_" — both hit the same api.intasend.com
# gateway. For real payments, use your live keys from the IntaSend
# dashboard (ISSecretKey_live_... / ISPubKey_live_...).
# Set this same value in your IntaSend dashboard webhook config —
# used to verify incoming webhooks are genuinely from IntaSend.
INTASEND_WEBHOOK_CHALLENGE=replace_with_a_long_random_value

# ---- Router integration (MikroTik) ----
# Fill these in for your actual router. See src/services/router.service.js —
# whitelisting a MAC depends entirely on your specific RouterOS/hotspot setup.
MIKROTIK_HOST=192.168.88.1
MIKROTIK_API_PORT=8728
MIKROTIK_USER=api-user
MIKROTIK_PASSWORD=replace_me

# ---- Admin bootstrap ----
# Used only by `npm run create-admin` — not read at runtime.
